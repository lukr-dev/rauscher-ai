{
	"name": "rauscher-ai",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"scripts": {
		"postinstall": "node scripts/patch-emdash-admin.mjs",
		"test": "node --test plugins/*/src/*.test.ts src/utils/*.test.ts",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "wrangler dev",
		"deploy": "astro build && wrangler deploy",
		"typecheck": "astro check",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write . && prettier --write \"{src,plugins}/**/*.astro\"",
		"format:check": "oxfmt --check . && prettier --check \"{src,plugins}/**/*.astro\"",
		"check": "npm run format:check && npm run lint && npm run typecheck",
		"cf:types": "wrangler types --include-runtime false"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.4",
		"@astrojs/react": "^7.1.2",
		"@emdash-cms/cloudflare": "^1.4.0",
		"@policystack/core": "^1.5.0",
		"@rauscher-ai/emdash-about-hero": "file:plugins/about-hero",
		"@rauscher-ai/emdash-active-quests": "file:plugins/active-quests",
		"@rauscher-ai/emdash-audio": "file:plugins/audio",
		"@rauscher-ai/emdash-blog-overview": "file:plugins/blog-overview",
		"@rauscher-ai/emdash-blog-preview": "file:plugins/blog-preview",
		"@rauscher-ai/emdash-career": "file:plugins/career",
		"@rauscher-ai/emdash-commits": "file:plugins/commits",
		"@rauscher-ai/emdash-hero": "file:plugins/hero",
		"@rauscher-ai/emdash-inventory": "file:plugins/inventory",
		"@rauscher-ai/emdash-level-up": "file:plugins/level-up",
		"@rauscher-ai/emdash-plunk-email": "file:plugins/plunk-email",
		"@rauscher-ai/emdash-skill-deck": "file:plugins/skill-deck",
		"astro": "^7.4.5",
		"emdash": "^1.4.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@cloudflare/workers-types": "^5.20261103.1",
		"@types/node": "^24.19.2",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.90.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"typescript": "^6.0.3",
		"wrangler": "^4.156.2"
	},
	"allowScripts": {
		"workerd": true,
		"esbuild": true
	},
	"emdash": {
		"label": "Starter",
		"seed": "seed/seed.json"
	}
}
