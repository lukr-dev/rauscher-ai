---
import { localizedHref } from "../../utils/i18n";
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	decodeSlug,
} from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
	locale: Astro.currentLocale,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	locale: Astro.currentLocale,
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}
---

<Base title={`${term.label} posts`} description={`Posts in ${term.label}`}>
	<h1>{term.label}</h1>

	{posts.length === 0 ? (
		<p>No posts in this category yet.</p>
	) : (
		<ul>
			{posts.map((post) => (
				<li>
					<a href={localizedHref(`/posts/${post.id}`, Astro.currentLocale)}>
						{post.data.featured_image && (
							<div {...post.edit.featured_image}>
								<Image image={post.data.featured_image} />
							</div>
						)}
						<h2 {...post.edit.title}>{post.data.title}</h2>
					</a>
					{post.data.excerpt && (
						<p {...post.edit.excerpt}>{post.data.excerpt}</p>
					)}
				</li>
			))}
		</ul>
	)}
	<nav aria-label="Pagination">
		{cursor && (
			<a href={localizedHref(`/category/${term.slug}`, Astro.currentLocale)}>
				First page
			</a>
		)}
		{nextCursor && (
			<a
				href={localizedHref(
					`/category/${term.slug}?cursor=${encodeURIComponent(nextCursor)}`,
					Astro.currentLocale,
				)}
			>
				Next page
			</a>
		)}
	</nav>
</Base>
