---
import { localizedHref, siteUi, type Locale } from "../utils/i18n";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const copy = {
	de: {
		settings: "Cookie-Einstellungen",
		title: "Optionale Analyse-Cookies",
		text: "Mit deiner Zustimmung laden wir Google Analytics, um die Nutzung dieser Website zu verstehen. Dabei werden Nutzungsdaten an Google übermittelt, auch in die USA. Ohne Zustimmung bleibt Google Analytics blockiert. Du kannst deine Wahl jederzeit in den Cookie-Einstellungen ändern. Wir merken uns deine Wahl für sechs Monate.",
		accept: "Akzeptieren",
		reject: "Ablehnen",
	},
	en: {
		settings: "Cookie settings",
		title: "Optional analytics cookies",
		text: "With your consent, we load Google Analytics to understand how this website is used. Usage data is sent to Google, including in the USA. Without consent, Google Analytics stays blocked. You can change your choice anytime in Cookie settings. We remember your choice for six months.",
		accept: "Accept",
		reject: "Reject",
	},
	fr: {
		settings: "Paramètres des cookies",
		title: "Cookies d’analyse facultatifs",
		text: "Avec votre accord, nous chargeons Google Analytics pour comprendre l’utilisation de ce site. Des données d’utilisation sont transmises à Google, y compris aux États-Unis. Sans accord, Google Analytics reste bloqué. Vous pouvez modifier votre choix à tout moment dans les paramètres des cookies. Nous mémorisons votre choix pendant six mois.",
		accept: "Accepter",
		reject: "Refuser",
	},
}[locale];
---

<button type="button" id="cookie-settings" hidden>
	{copy.settings}
</button>
<section
	id="cookie-banner"
	aria-labelledby="cookie-title"
	aria-describedby="cookie-description"
	hidden
>
	<h2 id="cookie-title">{copy.title}</h2>
	<p id="cookie-description">
		{copy.text}
		<a href={localizedHref("/datenschutz", locale)}>{siteUi(locale).privacy}</a>
	</p>
	<div class="cookie-actions">
		<button type="button" class="button" id="cookie-reject">
			{copy.reject}
		</button>
		<button type="button" class="button" id="cookie-accept">
			{copy.accept}
		</button>
	</div>
</section>

<script is:inline>
	(() => {
		if (
			location.protocol !== "https:" ||
			!["rauscher.ai", "www.rauscher.ai"].includes(location.hostname)
		)
			return;

		const measurementId = "G-Q3H6FGBQCN";
		const storageKey = "rauscher-analytics-consent-v1";
		const lifetime = 180 * 24 * 60 * 60 * 1000;
		const banner = document.getElementById("cookie-banner");
		const settings = document.getElementById("cookie-settings");
		const accept = document.getElementById("cookie-accept");
		const reject = document.getElementById("cookie-reject");
		let loaded = false;

		function readChoice() {
			try {
				const saved = JSON.parse(localStorage.getItem(storageKey));
				if (
					saved &&
					["accepted", "rejected"].includes(saved.choice) &&
					Number.isFinite(saved.expires) &&
					saved.expires > Date.now() &&
					saved.expires <= Date.now() + lifetime
				)
					return saved.choice;
			} catch {
				// Unavailable or malformed storage never implies consent.
			}
			return null;
		}

		function clearAnalyticsCookies() {
			for (const name of ["_ga", "_ga_Q3H6FGBQCN"]) {
				for (const domain of ["", location.hostname, "rauscher.ai"]) {
					document.cookie = `${name}=; Max-Age=0; Path=/;${domain ? ` Domain=${domain};` : ""} Secure; SameSite=Lax`;
				}
			}
		}

		function applyChoice(choice) {
			window[`ga-disable-${measurementId}`] = choice !== "accepted";
			banner.hidden = choice !== null;
			if (choice !== "accepted") {
				clearAnalyticsCookies();
				// Reload to unload an already-running tag, including automatic event listeners.
				if (loaded) location.reload();
				return;
			}
			if (loaded) return;
			loaded = true;
			window.dataLayer = window.dataLayer || [];
			window.gtag = function () {
				window.dataLayer.push(arguments);
			};
			window.gtag("consent", "default", {
				analytics_storage: "granted",
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
			});
			window.gtag("js", new Date());
			window.gtag("config", measurementId, {
				allow_google_signals: false,
				allow_ad_personalization_signals: false,
				cookie_expires: lifetime / 1000,
			});
			const script = document.createElement("script");
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
			document.head.appendChild(script);
		}

		function choose(choice) {
			try {
				localStorage.setItem(
					storageKey,
					JSON.stringify({ choice, expires: Date.now() + lifetime }),
				);
			} catch {
				// Consent still applies on this page when persistence is unavailable.
			}
			applyChoice(choice);
			settings.focus();
		}

		settings.hidden = false;
		settings.addEventListener("click", () => {
			banner.hidden = false;
			reject.focus();
		});
		accept.addEventListener("click", () => choose("accepted"));
		reject.addEventListener("click", () => choose("rejected"));
		window.addEventListener("storage", (event) => {
			if (event.key === storageKey || event.key === null)
				applyChoice(readChoice());
		});
		applyChoice(readChoice());
	})();
</script>

<style>
	#cookie-settings {
		border: 0;
		padding: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}
	#cookie-banner {
		position: fixed;
		z-index: 100;
		inset: auto 16px 16px;
		max-width: 660px;
		max-height: calc(100dvh - 32px);
		overflow: auto;
		margin-inline: auto;
		padding: 24px;
		border: 2px solid var(--ink);
		border-radius: 16px;
		background: var(--paper);
		color: var(--ink);
		box-shadow: 5px 5px 0 var(--ink);
		font-size: 15px;
		line-height: 1.5;
	}
	#cookie-banner h2 {
		margin: 0;
		font: 900 32px/1 var(--font-display);
	}
	.cookie-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.cookie-actions button {
		flex: 1;
	}
</style>
