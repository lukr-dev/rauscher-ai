---
import {
	getEmDashEntry,
	getSiteSettingsWithCacheHint,
	getSeoMeta,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { localizedHref } from "../utils/i18n";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const [{ entry: page, cacheHint, fallbackLocale }, settings] =
	await Promise.all([
		getEmDashEntry("pages", "home", { locale: Astro.currentLocale }),
		getSiteSettingsWithCacheHint(),
	]);
Astro.locals.contentLocale = fallbackLocale ?? Astro.currentLocale ?? "de";
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(settings.cacheHint);
}
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(settings.data);
const seo = page
	? getSeoMeta(page, {
			siteTitle,
			siteUrl: Astro.url.origin,
			path: localizedHref("/", Astro.currentLocale),
		})
	: undefined;
const title =
	seo?.title === `${siteTitle} | ${siteTitle}`
		? siteTitle
		: (seo?.title ?? siteTitle);
---

<Base
	title={title}
	description={seo?.description ?? siteTagline}
	canonical={seo?.canonical}
	content={
		page
			? {
					collection: "pages",
					id: page.data.id,
					slug: page.id,
					locale: fallbackLocale ?? Astro.currentLocale ?? "de",
				}
			: undefined
	}
>
	{page ? (
		<div {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	) : (
		<div class="content-page">
			<h1>{siteTitle}</h1>
			<p>
				Create a page with the slug “home” and add the homepage blocks in its
				rich-text editor.
			</p>
		</div>
	)}
</Base>
