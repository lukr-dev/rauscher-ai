# Local development only. Generate a key with:
# npx emdash secrets generate
EMDASH_ENCRYPTION_KEY=

# For HTTPS previews, put the key and full Tailscale URL in .dev.vars.
# For production, configure this as a Cloudflare Worker variable.
EMDASH_SITE_URL=http://localhost:4321

# Plunk secret key (sk_*) for EmDash mail. Optional locally: without it, astro dev
# prints mail to the terminal. Production: npx wrangler secret put PLUNK_SECRET_KEY
PLUNK_SECRET_KEY=
