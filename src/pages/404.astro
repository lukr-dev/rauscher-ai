---
import { siteUi, localizedHref } from "../utils/i18n";
const copy = siteUi(Astro.currentLocale);
Astro.response.status = 404;
import Base from "../layouts/Base.astro";
---

<Base title={copy.notFound}>
	<h1>{copy.notFound}</h1>
	<p>{copy.missingPage}</p>
	<a href={localizedHref("/", Astro.currentLocale)}>{copy.home}</a>
</Base>
