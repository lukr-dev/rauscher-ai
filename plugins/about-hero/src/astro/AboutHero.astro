---
import { siteUi, localizedHref } from "../../../../src/utils/i18n";
import { isSafeHref } from "emdash";
import type { ImageValue, PortableTextBlock } from "emdash";
import { Image, PortableText } from "emdash/ui";
import { aboutCardBack } from "../content";
interface Props {
	node: {
		heading?: string;
		badges?: { title: string }[];
		intro?: PortableTextBlock[];
		links?: { title: string; url: string }[];
		photo?: ImageValue;
		cardName?: string;
		backTitle?: string;
		facts?: { label?: string; value?: string }[];
		back?: PortableTextBlock[];
		abilityLabel?: string;
		abilityText?: string;
	};
}
const { node } = Astro.props;
const locale = Astro.currentLocale;
const copy = siteUi(locale);
const back = aboutCardBack(node);
---

<section class="about-hero">
	<div class="wrap about-grid">
		<div>
			<h1>{node.heading}</h1>
			<div class="badges">
				{(node.badges ?? []).map((badge) => (
					<span>{badge.title}</span>
				))}
			</div>
			<div class="rauscher-rich-text on-yellow copy-intro">
				<PortableText value={node.intro ?? []} />
			</div>
			<div class="contacts">
				{(node.links ?? [])
					.filter((link) => isSafeHref(link.url))
					.map((link, index) => (
						<a
							class:list={["button", { dark: index === 0 }]}
							href={localizedHref(link.url, locale)}
						>
							{link.title} ↗
						</a>
					))}
			</div>
		</div>
		<div class="portrait-wrap">
			<div
				class="portrait"
				role="button"
				tabindex="0"
				aria-pressed="false"
				aria-label={`${node.cardName ?? copy.profile}: ${copy.flip}`}
				data-about-card
			>
				<div class="front">
					{node.photo && (
						<Image image={node.photo} class="portrait-photo" priority />
					)}
					<span class="card-name">{node.cardName}</span>
				</div>
				<div class="back" data-about-back aria-hidden="true">
					{back.title && <h2>{back.title}</h2>}
					{back.facts.length > 0 && (
						<dl class="facts">
							{back.facts.map((fact) => (
								<div>
									<dt>{fact.label}</dt>
									<dd>{fact.value}</dd>
								</div>
							))}
						</dl>
					)}
					{(node.abilityLabel?.trim() || node.abilityText?.trim()) && (
						<div class="ability">
							{node.abilityLabel?.trim() && (
								<strong>{node.abilityLabel}</strong>
							)}
							{node.abilityText?.trim() && <p>{node.abilityText}</p>}
						</div>
					)}
				</div>
			</div>
			<p class="hint">{copy.clickCard} ↻</p>
		</div>
	</div>
</section>
<script>
	for (const card of document.querySelectorAll<HTMLElement>(
		"[data-about-card]",
	)) {
		const back = card.querySelector<HTMLElement>("[data-about-back]")!;
		const flip = (flipped: boolean) => {
			card.classList.toggle("flipped", flipped);
			card.setAttribute("aria-pressed", String(flipped));
			back.setAttribute("aria-hidden", String(!flipped));
		};
		const toggle = () => flip(!card.classList.contains("flipped"));
		card.addEventListener("click", toggle);
		card.addEventListener("keydown", (event) => {
			if (event.key === "Enter" || event.key === " ") {
				event.preventDefault();
				toggle();
			} else if (event.key === "Escape") flip(false);
		});
		// Tilt towards the hovered corner; measured on the untransformed wrapper so the tilt doesn't feed back.
		const wrap = card.parentElement!;
		const tilt = window.matchMedia(
			"(hover: hover) and (prefers-reduced-motion: no-preference)",
		);
		card.addEventListener("pointermove", (event) => {
			if (!tilt.matches || event.pointerType !== "mouse") return;
			const rect = wrap.getBoundingClientRect();
			const x = (event.clientX - rect.left) / rect.width - 0.5;
			const y = (event.clientY - rect.top) / card.offsetHeight - 0.5;
			card.style.setProperty("--tilt-x", `${(-y * 16).toFixed(2)}deg`);
			card.style.setProperty("--tilt-y", `${(x * 16).toFixed(2)}deg`);
		});
		card.addEventListener("pointerleave", () => {
			card.style.removeProperty("--tilt-x");
			card.style.removeProperty("--tilt-y");
		});
	}
</script>
<style>
	.about-hero {
		padding: 40px 0 110px;
		overflow: clip;
	}
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 380px;
		gap: 72px;
		align-items: center;
	}
	h1 {
		font: 900 clamp(96px, 13vw, 200px)/0.78 var(--font-display);
		letter-spacing: -0.03em;
		margin: 0 0 30px;
	}
	.badges,
	.contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 24px 0;
	}
	.badges span {
		border: 2px solid var(--ink);
		border-radius: 99px;
		padding: 8px 14px;
		font-size: 13px;
		font-weight: 700;
	}
	.badges span:first-child {
		background: var(--ink);
		color: var(--paper);
	}
	.badges span:nth-child(3n + 2) {
		background: var(--blue);
		color: var(--ink);
	}
	.badges span:last-child {
		background: var(--paper);
	}
	.contacts .button {
		background: var(--paper);
	}
	.contacts .dark {
		background: var(--ink);
	}
	.contacts {
		margin-top: 52px;
	}
	.portrait-wrap {
		justify-self: center;
		width: min(100%, 320px);
	}
	.portrait {
		position: relative;
		height: 460px;
		perspective: 1200px;
		transform: perspective(900px) rotate(4deg) rotateX(var(--tilt-x, 0deg))
			rotateY(var(--tilt-y, 0deg));
		transition: transform 0.4s ease-out;
		cursor: pointer;
	}
	.portrait:hover {
		transition-duration: 0.12s;
	}
	.portrait:focus-visible {
		outline: 4px solid var(--blue-deep);
		outline-offset: 8px;
		border-radius: 24px;
	}
	.front,
	.back {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 12px;
		box-sizing: border-box;
		border: 2px solid var(--ink);
		border-radius: 22px;
		box-shadow: 8px 8px 0 var(--ink);
		backface-visibility: hidden;
		transition: transform 0.55s;
	}
	.front {
		background: var(--paper);
		color: var(--ink);
	}
	.front :global(.portrait-photo) {
		width: 100%;
		flex: 1;
		min-height: 0;
		object-fit: cover;
		object-position: 50% 20%;
		border: 2px solid var(--ink);
		border-radius: 14px;
	}
	.card-name {
		font: 900 34px/0.95 var(--font-display);
	}
	.back {
		background: var(--ink);
		color: var(--paper);
		transform: rotateY(180deg);
		padding: 26px 24px 24px;
		visibility: hidden;
		overflow-y: auto;
	}
	.back h2 {
		color: var(--yellow);
		font: 900 36px/1 var(--font-display);
		margin: 0 0 6px;
	}
	.facts {
		margin: 0;
		font-size: 15px;
	}
	.facts div {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		padding: 10px 0;
		border-bottom: 1px dashed #fffdf64d;
	}
	.facts dt {
		color: #fffdf6b3;
	}
	.facts dd {
		margin: 0;
		font-weight: 700;
		text-align: right;
	}
	.flipped .front {
		transform: rotateY(-180deg);
		visibility: hidden;
	}
	.flipped .back {
		transform: rotateY(0deg);
		visibility: visible;
	}
	.ability {
		margin-top: auto;
		font-size: 15px;
	}
	.ability strong {
		color: var(--yellow);
		text-transform: uppercase;
		font-size: 11px;
		letter-spacing: 0.08em;
	}
	.ability p {
		margin: 8px 0;
	}
	.hint {
		text-align: center;
		font-size: 13px;
		margin-top: 30px;
	}
	@media (max-width: 900px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 44px;
		}
		.about-hero {
			padding-top: 30px;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.portrait,
		.front,
		.back {
			transition: none;
		}
	}
</style>
