---
import BlogFilterPage from "../../components/BlogFilterPage.astro";
import { loadBlogFilter } from "../../utils/blog-filter";
import { localizedHref } from "../../utils/i18n";

const filter = await loadBlogFilter(Astro, "tag");
if (!filter) return Astro.rewrite(localizedHref("/404", Astro.currentLocale));
---

<BlogFilterPage {...filter} />
