{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rauscher-ai",
	"account_id": "7979b4f7816680c8ba9be80700d1abe4",
	"workers_dev": true,
	"vars": {
		"EMDASH_SITE_URL": "https://rauscher-ai.lueku-rauscher.workers.dev",
	},
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rauscher-ai",
			"database_id": "c79cfb91-8839-4fc6-96d5-1103f90bdfb4",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "rauscher-ai-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "c340ff7fb33946eb80fb593965d591f0",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
