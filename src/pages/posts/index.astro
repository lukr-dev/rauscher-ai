---
import {
	getEmDashEntry,
	getSiteSettingsWithCacheHint,
	getSeoMeta,
} from "emdash";
import { PortableText } from "emdash/ui";
import BlogOverview from "../../../plugins/blog-overview/src/astro/BlogOverview.astro";
import {
	blogFilterPath,
	legacyFilterPath,
} from "../../../plugins/blog-overview/src/content";
import Base from "../../layouts/Base.astro";
import { localizedHref } from "../../utils/i18n";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const legacyFilter = legacyFilterPath(Astro.url.searchParams);
if (legacyFilter)
	return Astro.redirect(localizedHref(legacyFilter, Astro.currentLocale), 301);
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const [{ entry: page, cacheHint, fallbackLocale }, settings] =
	await Promise.all([
		getEmDashEntry("pages", "posts", { locale: Astro.currentLocale }),
		getSiteSettingsWithCacheHint(),
	]);
Astro.locals.contentLocale = fallbackLocale ?? Astro.currentLocale ?? "de";
if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(settings.cacheHint);
}
const { siteTitle } = resolveStarterSiteIdentity(settings.data);
const seo = page
	? getSeoMeta(page, {
			siteTitle,
			siteUrl: Astro.url.origin,
			path: localizedHref(
				blogFilterPath(undefined, cursor),
				Astro.currentLocale,
			),
		})
	: undefined;
---

<Base
	title={seo?.title ?? "Blog"}
	pageTitle={seo?.ogTitle}
	description={seo?.description}
	canonical={seo?.canonical}
	robots={cursor ? "noindex, follow" : undefined}
	content={
		page
			? {
					collection: "pages",
					id: page.data.id,
					slug: page.id,
					locale: fallbackLocale ?? Astro.currentLocale ?? "de",
				}
			: undefined
	}
>
	{page ? (
		<div {...page.edit.content}>
			<PortableText value={page.data.content} />
		</div>
	) : (
		<BlogOverview node={{ heading: "Blog" }} />
	)}
</Base>
